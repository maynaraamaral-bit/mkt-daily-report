# ------------------------------------------------------------------------------
# 11. DIVERSOS
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.old
*.orig
*.rej
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.iso
.terraform/
*.tfstate
*.tfstate.*
_to_delete/

# ==============================================================================
# 12. CÓDIGO-FONTE — SEMPRE VERSIONADO  ✅  (REGRA INEGOCIÁVEL)
#     .py / .html / .md entram no Git em qualquer pasta do projeto, sem exceção
#     e sem filtro de segurança. Estas regras são as últimas do arquivo e por
#     isso vencem TODOS os padrões acima.
#     Se um script tiver chave ou senha em código, resolva no código (mova para
#     .env), não no .gitignore.
# ==============================================================================
!*.py
!*.html
!*.htm
!*.md
!**/*.py
!**/*.html
!**/*.htm
!**/*.md

# Complementos de código que também nunca devem ser ignorados
!*.ipynb
!*.js
!*.jsx
!*.ts
!*.tsx
!*.css
!*.scss
!*.toml
!*.yml
!*.yaml
!requirements*.txt
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!Pipfile
!Pipfile.lock
!pyproject.toml
!README*
!LICENSE*
!.gitignore
